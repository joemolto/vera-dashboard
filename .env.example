# Vera dashboard, self-hosted. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# Legacy JWT secret (Project Settings -> JWT Keys). Required for the MCP server,
# which uses it to scope each request to the caller's own data.
SUPABASE_JWT_SECRET=

# The Vera engine: base URL (no /api/v1, no trailing slash) and its API_SECRET_KEY.
# The edge functions run in Supabase's cloud, so for them (and for any
# deployment) this must be the engine's public HTTPS URL, not localhost.
ENGINE_API_BASE=http://localhost:8000
ENGINE_API_KEY=same-value-as-the-engine-API_SECRET_KEY

# Ask Vera (chat) runs on Claude.
ANTHROPIC_API_KEY=

# This dashboard's public URL, and the engine's public URL for the API docs card.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Self-hosted mode (hides hosted billing and plan screens) is on unless "false".
# NEXT_PUBLIC_SELF_HOSTED=true

# Optional: sharper company logos from logo.dev (otherwise site favicons).
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# HubSpot and Slack integrations are unfinished and switched off, so their
# HUBSPOT_*, SLACK_* and INTEGRATIONS_BASE_URL settings aren't needed.

# Optional monitoring. Both stay off while empty.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# The Supabase edge functions (supabase/functions) read their own secrets:
#   supabase secrets set ENGINE_API_BASE=... ENGINE_API_KEY=... APOLLO_API_KEY=...
